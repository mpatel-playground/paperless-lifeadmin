# Copy to .env and fill in. Never commit .env.

# --- Paperless (dev stack) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_ADMIN_USER=admin
# Only used when the admin user is first created; changing it later has no effect.
PAPERLESS_ADMIN_PASSWORD=change-me

# --- Add-on ---
PAPERLESS_URL=http://localhost:8000
# Create after `make up`: log in at http://localhost:8000 -> My Profile -> API Auth Token.
PAPERLESS_TOKEN=change-me
# For scripts on the host. From inside a container use http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Web UI address. Keep 127.0.0.1 unless you know you need network access.
# BIND_HOST=127.0.0.1
